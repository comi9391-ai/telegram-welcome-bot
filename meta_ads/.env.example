# Meta 비즈니스 설정 > 시스템 사용자 > 토큰 생성
# 필요한 권한: ads_management, ads_read, pages_manage_ads, pages_read_engagement,
#             pages_show_list, leads_retrieval, business_management
META_ACCESS_TOKEN=

# 광고관리자 주소창의 act= 뒤 숫자
META_AD_ACCOUNT_ID=act_

# 워프파이프 페이지 ID (페이지 > 정보 > 페이지 투명성)
META_PAGE_ID=

# 광고를 넣을 광고 세트 ID (캠페인 목표: 잠재 고객, 전환 위치: 인스턴트 양식)
META_ADSET_ID=

# 인스타그램에도 워프파이프 이름으로 띄우려면 연결된 인스타 계정 ID (선택)
META_INSTAGRAM_USER_ID=

# 신청서에 필수. 개인정보처리방침 페이지 주소
PRIVACY_POLICY_URL=

# 신청 완료 화면 버튼이 열 주소. 랜딩페이지 나오기 전엔 텔레그램 채널 링크 등
FOLLOW_UP_URL=
